<?xml version="1.0" encoding="UTF-8"?><process version="12.1.001">
  <context>
    <input/>
    <output/>
    <macros/>
  </context>
  <operator activated="true" class="process" compatibility="12.1.001" expanded="true" name="Process">
    <parameter key="random_seed" value="42"/>
    <process expanded="true">
      <operator activated="true" class="read_csv" compatibility="12.1.001" expanded="true" height="68" name="Read CSV Data" width="90" x="45" y="34">
        <parameter key="csv_file" value="D:/MLPasokanMataram/pipeline/data_training.csv"/>
        <parameter key="column_separators" value=","/>
        <parameter key="trim_lines" value="true"/>
        <parameter key="use_quotes" value="true"/>
        <parameter key="quotes_character" value="&quot;"/>
        <parameter key="escape_character" value="\"/>
        <parameter key="skip_comments" value="false"/>
        <parameter key="starting_row" value="1"/>
        <parameter key="parse_numbers" value="true"/>
        <parameter key="decimal_character" value="."/>
        <parameter key="grouped_digits" value="false"/>
        <parameter key="date_format" value="yyyy-MM-dd"/>
        <parameter key="first_row_as_names" value="true"/>
        <parameter key="encoding" value="UTF-8"/>
        <parameter key="read_all_values_as_polynominal" value="false"/>
        <list key="data_set_meta_data_information">
          <parameter key="0" value="date.true.date.attribute"/>
          <parameter key="1" value="commodity_code.true.polynominal.attribute"/>
          <parameter key="2" value="commodity_name.true.polynominal.attribute"/>
          <parameter key="3" value="price.true.real.attribute"/>
          <parameter key="4" value="rainfall_mm.true.real.attribute"/>
          <parameter key="5" value="is_weekend.true.integer.attribute"/>
          <parameter key="6" value="is_long_weekend.true.integer.attribute"/>
          <parameter key="7" value="is_holiday_season.true.integer.attribute"/>
          <parameter key="8" value="demand_shock_score.true.real.attribute"/>
        </list>
        <parameter key="read_not_matching_values_as_missings" value="true"/>
      </operator>
      <operator activated="true" class="filter_examples" compatibility="12.1.001" expanded="true" height="103" name="Filter Missing &amp; Invalids" width="90" x="179" y="34">
        <parameter key="condition_class" value="no_missing_attributes"/>
        <parameter key="invert_filter" value="false"/>
      </operator>
      <operator activated="true" class="replace_missing_values" compatibility="12.1.001" expanded="true" height="103" name="Impute Missing Rain" width="90" x="313" y="34">
        <parameter key="return_preprocessing_model" value="false"/>
        <parameter key="attribute_filter_type" value="single"/>
        <parameter key="attribute" value="rainfall_mm"/>
        <parameter key="default" value="zero"/>
        <list key="columns"/>
      </operator>
      <operator activated="true" class="generate_attributes" compatibility="12.1.001" expanded="true" height="82" name="Generate Calendar Feats" width="90" x="447" y="34">
        <list key="function_descriptions">
          <parameter key="day_of_month" value="date_get(date, DATE_UNIT_DAY)"/>
          <parameter key="month_val" value="date_get(date, DATE_UNIT_MONTH)"/>
          <parameter key="sin_day" value="sin(2 * 3.14159265 * date_get(date, DATE_UNIT_DAY) / 30)"/>
          <parameter key="cos_day" value="cos(2 * 3.14159265 * date_get(date, DATE_UNIT_DAY) / 30)"/>
        </list>
        <parameter key="keep_all" value="true"/>
      </operator>
      <operator activated="true" class="normalize" compatibility="12.1.001" expanded="true" height="103" name="Normalize Exogenous" width="90" x="581" y="34">
        <parameter key="return_preprocessing_model" value="false"/>
        <parameter key="create_view" value="false"/>
        <parameter key="attribute_filter_type" value="subset"/>
        <parameter key="attribute" value=""/>
        <parameter key="attributes" value="rainfall_mm|demand_shock_score"/>
        <parameter key="use_except_expression" value="false"/>
        <parameter key="value_type" value="numeric"/>
        <parameter key="use_value_type_exception" value="false"/>
        <parameter key="except_value_type" value="real"/>
        <parameter key="block_type" value="value_series"/>
        <parameter key="use_block_type_exception" value="false"/>
        <parameter key="except_block_type" value="value_series_end"/>
        <parameter key="invert_selection" value="false"/>
        <parameter key="include_special_attributes" value="false"/>
        <parameter key="method" value="Z-transformation"/>
        <parameter key="min" value="0.0"/>
        <parameter key="max" value="1.0"/>
      </operator>
      <operator activated="true" class="write_csv" compatibility="12.1.001" expanded="true" height="82" name="Write Preprocessed CSV" width="90" x="715" y="34">
        <parameter key="csv_file" value="D:/MLPasokanMataram/pipeline/data_preprocessed.csv"/>
        <parameter key="write_attribute_names" value="true"/>
        <parameter key="quote_nominal_values" value="true"/>
        <parameter key="format_date_attributes" value="true"/>
        <parameter key="append_to_file" value="false"/>
        <parameter key="encoding" value="UTF-8"/>
      </operator>
      <connect from_op="Read CSV Data" from_port="output" to_op="Filter Missing &amp; Invalids" to_port="example set input"/>
      <connect from_op="Filter Missing &amp; Invalids" from_port="example set output" to_op="Impute Missing Rain" to_port="example set input"/>
      <connect from_op="Impute Missing Rain" from_port="example set output" to_op="Generate Calendar Feats" to_port="example set input"/>
      <connect from_op="Generate Calendar Feats" from_port="example set output" to_op="Normalize Exogenous" to_port="example set input"/>
      <connect from_op="Normalize Exogenous" from_port="example set output" to_op="Write Preprocessed CSV" to_port="input"/>
      <connect from_op="Write Preprocessed CSV" from_port="through" to_port="result 1"/>
      <portSpacing port="source_input 1" spacing="0"/>
      <portSpacing port="sink_result 1" spacing="0"/>
      <portSpacing port="sink_result 2" spacing="0"/>
    </process>
  </operator>
</process>
